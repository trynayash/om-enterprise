# ---------------------------------------------------------------------------
# OM Enterprise — environment variables. Copy to `.env` and fill in.
# NEVER commit real values. All secrets are server-only (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase/Neon/self-hosted). Use sslmode=require for managed DBs.
DATABASE_URL=postgres://om:om_dev_password@localhost:5432/om_dev

# Separate database used by `npm run test:integration` (it is wiped on every run!).
TEST_DATABASE_URL=postgres://om:om_dev_password@localhost:5432/om_test

# Public base URL of the site, used for share links and origin checks.
APP_BASE_URL=http://localhost:3000

# Random secret (>= 32 chars) used to hash IP addresses for rate limiting / enquiries.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where uploaded product images are stored when using the local storage driver.
UPLOAD_DIR=./storage/uploads

# --- Optional: email the bill to the customer (see README, "Sending bills by email") ---
# EMAIL_FROM=OM ENTERPRISE <bills@your-verified-domain>
# RESEND_API_KEY=
# Development only: write mail to files in this folder instead of sending it.
# EMAIL_OUTBOX_DIR=./storage/outbox

# --- Optional: payment gateway (leave empty to use manual UPI verification only) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Separate database for Playwright e2e runs (wiped by `npm run test:e2e`).
E2E_DATABASE_URL=postgres://om:om_dev_password@localhost:5432/om_e2e
