# Production secrets for docker-compose. NEVER commit the filled-in copy.
POSTGRES_PASSWORD=generate-a-long-random-password
APP_SECRET=generate-with-node-crypto-randomBytes-32-base64url
APP_BASE_URL=https://www.your-domain.example
# Optional — email the bill to the customer (README, "Sending bills by email"):
EMAIL_FROM=OM ENTERPRISE <shop@gmail.com>
SMTP_USER=shop@gmail.com
SMTP_PASSWORD=
# (or RESEND_API_KEY= with a domain verified at Resend)
# Optional — only after Razorpay QR Codes are activated on your account:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
