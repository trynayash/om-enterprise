{
  "name": "om-enterprise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-engine-files.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-engine-files.mjs",
    "build": "next build",
    "vercel-build": "node scripts/copy-engine-files.mjs && npm run db:migrate && npm run create-super-admin -- --if-missing && npm run import:products -- --publish --apply-market-prices --refresh-content && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ocr": "vitest run --project ocr",
    "test:integration": "vitest run --project integration",
    "test:e2e": "tsx --conditions=react-server scripts/e2e-prepare.ts && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "create-super-admin": "tsx --conditions=react-server scripts/create-super-admin.ts",
    "reset-login-secret": "tsx --conditions=react-server scripts/reset-login-secret.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "import:products": "tsx --conditions=react-server scripts/import-products.ts",
    "walkthrough": "tsx --conditions=react-server scripts/walkthrough-prepare.ts && playwright test -c playwright.walkthrough.config.ts; tsx scripts/walkthrough-report.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
